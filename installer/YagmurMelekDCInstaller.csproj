<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets/yagmurmelekdc.ico</ApplicationIcon>
    <AssemblyName>YagmurMelekDcInstaller</AssemblyName>
    <RootNamespace>YagmurMelekDCInstaller</RootNamespace>

    <!-- Şirket ve Sahip Bilgileri -->
    <Company>YagmurMelek</Company>
    <Authors>YagmurMelek</Authors>
    <Product>YagmurMelek Discord</Product>
    <Title>YagmurMelek Discord Kurulum Yöneticisi</Title>
    <AssemblyTitle>YagmurMelek Discord Kurulum Yöneticisi</AssemblyTitle>
    <Description>YagmurMelek Discord Resmi Kurulum Programı</Description>
    <Copyright>(c) 2026 YagmurMelek. Tüm hakları saklıdır.</Copyright>
    <Trademark>YagmurMelek Discord</Trademark>
    <PackageProjectUrl>https://github.com/Yagmur1337/YagmurDiscord</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Yagmur1337/YagmurDiscord</RepositoryUrl>
    <PackageId>YagmurDiscord.Installer</PackageId>
    <NeutralLanguage>tr-TR</NeutralLanguage>

    <!-- Sürüm Bilgileri -->
    <Version>0.6.2</Version>
    <FileVersion>0.6.2.0</FileVersion>
    <AssemblyVersion>0.6.2.0</AssemblyVersion>
    <InformationalVersion>0.6.2 - YagmurMelek</InformationalVersion>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DefaultItemExcludes>$(DefaultItemExcludes);cli/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip"/>
    <EmbeddedResource Include="bootstrap.cjs"/>
    <EmbeddedResource Include="defaultSettings.json"/>
    <EmbeddedResource Include="assets/yagmurmelekdc.ico"/>
    <EmbeddedResource Include="assets/yagmurmelekdc.png"/>
  </ItemGroup>
</Project>
