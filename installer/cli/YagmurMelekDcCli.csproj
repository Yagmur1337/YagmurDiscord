<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../assets/yagmurmelekdc.ico</ApplicationIcon>
    <AssemblyName>YagmurMelekDcCli</AssemblyName>
    <RootNamespace>YagmurMelekDCInstaller</RootNamespace>

    <!-- Şirket ve Sahip Bilgileri -->
    <Company>Yagmures Holding</Company>
    <Authors>Yagmur Discord, Yagmures Holding</Authors>
    <Product>Yagmur Discord CLI</Product>
    <Title>Yagmur Discord Komut Satırı Yükleyicisi</Title>
    <AssemblyTitle>Yagmur Discord Komut Satırı Yükleyicisi</AssemblyTitle>
    <Description>Yagmur Discord Komut Satırı Kurulum Aracı - Yagmures Holding</Description>
    <Copyright>(c) 2026 Yagmures Holding. Tum haklari saklidir.</Copyright>
    <Trademark>Yagmures Holding - Yagmur Discord</Trademark>
    <PackageProjectUrl>https://github.com/Yagmur1337/YagmurDiscord</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Yagmur1337/YagmurDiscord</RepositoryUrl>
    <PackageId>YagmurDiscord.CLI</PackageId>
    <NeutralLanguage>tr-TR</NeutralLanguage>

    <!-- Sürüm Bilgileri -->
    <Version>0.5.5</Version>
    <FileVersion>0.5.5.0</FileVersion>
    <AssemblyVersion>0.5.5.0</AssemblyVersion>
    <InformationalVersion>0.5.5 - Yagmures Holding</InformationalVersion>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Program.cs" Link="Program.cs" />
    <Compile Include="../InstallEngine.cs" Link="InstallEngine.cs" />
    <Compile Include="../SelfTest.cs" Link="SelfTest.cs" />
    <EmbeddedResource Include="../payload.zip" Link="payload.zip" />
    <EmbeddedResource Include="../bootstrap.cjs" Link="bootstrap.cjs" />
    <EmbeddedResource Include="../defaultSettings.json" Link="defaultSettings.json" />
    <EmbeddedResource Include="../assets/yagmurmelekdc.ico" Link="assets/yagmurmelekdc.ico" />
    <EmbeddedResource Include="../assets/yagmurmelekdc.png" Link="assets/yagmurmelekdc.png" />
  </ItemGroup>
</Project>
